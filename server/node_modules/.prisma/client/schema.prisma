generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guru {
  id       String @id @default(uuid())
  username String @unique
  password String
  nama     String
}

model Siswa {
  id                  String                @id @default(uuid())
  nama                String
  tanggalLahir        DateTime
  kelas               String
  rombel              String
  jenisKelamin        String
  nis                 String?
  password            String
  aktivitas           AktivitasSiswa[]
  collab2             CollabTugas[]         @relation("Siswa2")
  collab1             CollabTugas[]         @relation("Siswa1")
  kehadiran           Kehadiran[]
  pengumpulan         Pengumpulan[]
  pengumpulanMengetik PengumpulanMengetik[]
  xpPenalti           XpPenalti[]
}

model Tugas {
  id                  String                @id @default(uuid())
  judul               String
  deskripsi           String?
  jenis               String
  status              String                @default("draft")
  deadline            DateTime?
  kelasTarget         String
  rombelTarget        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  batchId             String?
  naskahMengetik      String?
  bobotKebenaran      Float?
  bobotKecepatan      Float?
  closedAt            DateTime?
  publishedAt         DateTime?
  aktivitas           AktivitasSiswa[]
  collab              CollabTugas[]
  lampiran            LampiranTugas[]
  pengumpulan         Pengumpulan[]
  pengumpulanMengetik PengumpulanMengetik[]
  xpPenalti           XpPenalti[]

  @@index([batchId])
}

model LampiranTugas {
  id       String @id @default(uuid())
  tugasId  String
  namaFile String
  path     String
  tugas    Tugas  @relation(fields: [tugasId], references: [id], onDelete: Cascade)
}

model Pengumpulan {
  id         String   @id @default(uuid())
  tugasId    String
  siswaId    String
  namaFile   String
  path       String
  ukuran     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  nilai      Float?
  keterangan String?
  xpBase     Float    @default(0)
  xpNilai    Float    @default(0)
  xpEarly    Float    @default(0)
  xpPerfect  Float    @default(0)
  xpBonus    Float    @default(0)
  xpTotal    Float    @default(0)
  siswa      Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tugas      Tugas    @relation(fields: [tugasId], references: [id], onDelete: Cascade)
}

model PengumpulanMengetik {
  id            String    @id @default(uuid())
  tugasId       String
  siswaId       String
  hasilKetik    String?
  status        String    @default("belum_mulai")
  waktuMulai    DateTime?
  waktuSelesai  DateTime?
  durasiDetik   Float?
  skorKebenaran Float     @default(0)
  skorKecepatan Float     @default(0)
  skorTotal     Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  xpBase        Float     @default(0)
  xpNilai       Float     @default(0)
  xpEarly       Float     @default(0)
  xpPerfect     Float     @default(0)
  xpBonus       Float     @default(0)
  xpTotal       Float     @default(0)
  siswa         Siswa     @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tugas         Tugas     @relation(fields: [tugasId], references: [id], onDelete: Cascade)

  @@unique([tugasId, siswaId])
  @@index([tugasId])
  @@index([siswaId])
}

model AktivitasSiswa {
  id        String   @id @default(uuid())
  siswaId   String
  tugasId   String?
  jenis     String
  deskripsi String?
  createdAt DateTime @default(now())
  tugas     Tugas?   @relation(fields: [tugasId], references: [id])
  siswa     Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@index([siswaId])
  @@index([tugasId])
  @@index([jenis])
  @@index([createdAt])
}

model Pengaturan {
  id                        String  @id @default("1")
  logoPath                  String?
  namaSekolah               String  @default("Sekolah Kita")
  alamat                    String?
  baseDir                   String  @default("./storage")
  tema                      String  @default("light")
  jamLogout                 Int     @default(60)
  submissionFolderPattern   String  @default("KELAS_ROMBEL/NAMA_TUGAS")
  duplicateFileHandling     String  @default("RENAME_INCREMENT")
  backupDir                 String?
  autoBackupEnabled         Boolean @default(false)
  autoBackupIntervalSeconds Int     @default(3600)
}

model QuickShareRoom {
  id         String           @id @default(uuid())
  kode       String           @unique
  nama       String
  password   String?
  mode       String
  batasWaktu DateTime
  batasSize  Int?
  batasFile  Int?
  status     String           @default("aktif")
  createdAt  DateTime         @default(now())
  hostId     String?
  hostRole   String?
  files      QuickShareFile[]

  @@index([hostId])
}

model QuickShareFile {
  id           String         @id @default(uuid())
  roomId       String
  namaFile     String
  path         String
  ukuran       Int
  pengirim     String
  tipePengirim String         @default("GUEST")
  createdAt    DateTime       @default(now())
  room         QuickShareRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model XpSetting {
  id                   String @id @default("1")
  xpBase               Float  @default(80)
  xpNilai70            Float  @default(20)
  xpNilai80            Float  @default(40)
  xpNilai90            Float  @default(70)
  xpNilai100           Float  @default(100)
  xpEarly              Float  @default(25)
  xpPerfect            Float  @default(70)
  xpBonusMax           Float  @default(20)
  titleConfig          String @default("[]")
  xpPenaltiTidakKumpul Float  @default(-50)
}

model SampahPengumpulan {
  id         String   @id @default(uuid())
  jenis      String
  originalId String
  tugasId    String
  siswaId    String
  tugasJudul String
  siswaNama  String
  dataJson   String
  deletedAt  DateTime @default(now())

  @@index([tugasId])
  @@index([siswaId])
  @@index([deletedAt])
}

model XpPenalti {
  id         String   @id @default(uuid())
  siswaId    String
  tugasId    String?
  xp         Float    @default(-50)
  keterangan String?
  createdAt  DateTime @default(now())
  tugas      Tugas?   @relation(fields: [tugasId], references: [id])
  siswa      Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tugasId])
  @@index([siswaId])
  @@index([tugasId])
}

model Kehadiran {
  id         String   @id @default(uuid())
  siswaId    String
  tanggal    DateTime
  status     String
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  siswa      Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tanggal])
  @@index([siswaId])
  @@index([tanggal])
}

model AcakState {
  id         String   @id @default(uuid())
  kelas      String
  rombel     String
  devices    String
  ringkasan  String
  tidakMasuk String
  updatedAt  DateTime @updatedAt

  @@unique([kelas, rombel])
}

model CollabTugas {
  id        String   @id @default(uuid())
  tugasId   String
  siswa1Id  String
  siswa2Id  String
  createdAt DateTime @default(now())
  siswa2    Siswa    @relation("Siswa2", fields: [siswa2Id], references: [id], onDelete: Cascade)
  siswa1    Siswa    @relation("Siswa1", fields: [siswa1Id], references: [id], onDelete: Cascade)
  tugas     Tugas    @relation(fields: [tugasId], references: [id], onDelete: Cascade)

  @@unique([tugasId, siswa1Id])
  @@unique([tugasId, siswa2Id])
  @@index([tugasId])
}
