generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guru {
  id       String @id @default(uuid())
  username String @unique
  password String
  nama     String
}

model Siswa {
  id            String        @id @default(uuid())
  nama          String
  tanggalLahir  DateTime
  kelas         String
  rombel        String
  jenisKelamin  String
  nis           String?
  password      String
  pengumpulan   Pengumpulan[]
  pengumpulanMengetik PengumpulanMengetik[]
  aktivitas     AktivitasSiswa[]
  xpPenalti     XpPenalti[]
}

model Tugas {
  id               String          @id @default(uuid())
  judul            String
  deskripsi        String?
  jenis            String
  status           String          @default("draft")
  deadline         DateTime?
  kelasTarget      String
  rombelTarget     String?
  batchId          String?
  naskahMengetik   String?
  bobotKebenaran   Float?
  bobotKecepatan   Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lampiran         LampiranTugas[]
  pengumpulan      Pengumpulan[]
  pengumpulanMengetik PengumpulanMengetik[]
  aktivitas        AktivitasSiswa[]
  xpPenalti        XpPenalti[]

  @@index([batchId])
}

model LampiranTugas {
  id       String @id @default(uuid())
  tugasId  String
  namaFile String
  path     String
  tugas    Tugas  @relation(fields: [tugasId], references: [id], onDelete: Cascade)
}

model Pengumpulan {
  id          String   @id @default(uuid())
  tugasId     String
  siswaId     String
  namaFile    String
  path        String
  ukuran      Int
  nilai       Float?   // Nilai yang diberikan guru (0–100)
  keterangan  String?  // Catatan/keterangan dari guru
  xpBase      Float    @default(0)
  xpNilai     Float    @default(0)
  xpEarly     Float    @default(0)
  xpPerfect   Float    @default(0)
  xpBonus     Float    @default(0)
  xpTotal     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tugas       Tugas    @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswa       Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
}

model PengumpulanMengetik {
  id            String    @id @default(uuid())
  tugasId       String
  siswaId       String
  hasilKetik    String?
  status        String    @default("belum_mulai")
  waktuMulai    DateTime?
  waktuSelesai  DateTime?
  durasiDetik   Float?
  skorKebenaran Float     @default(0)
  skorKecepatan Float     @default(0)
  skorTotal     Float     @default(0)
  xpBase        Float     @default(0)
  xpNilai       Float     @default(0)
  xpEarly       Float     @default(0)
  xpPerfect     Float     @default(0)
  xpBonus       Float     @default(0)
  xpTotal       Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tugas         Tugas     @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswa         Siswa     @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([tugasId, siswaId])
  @@index([tugasId])
  @@index([siswaId])
}

model AktivitasSiswa {
  id        String   @id @default(uuid())
  siswaId   String
  tugasId   String?
  jenis     String
  deskripsi String?
  createdAt DateTime @default(now())
  siswa     Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tugas     Tugas?   @relation(fields: [tugasId], references: [id], onDelete: SetNull)

  @@index([siswaId])
  @@index([tugasId])
  @@index([jenis])
  @@index([createdAt])
}

model Pengaturan {
  id          String @id @default("1")
  logoPath    String?
  namaSekolah String @default("Sekolah Kita")
  alamat      String?
  baseDir     String @default("./storage")
  tema        String @default("light")
  jamLogout   Int    @default(60)
  submissionFolderPattern String @default("KELAS_ROMBEL/NAMA_TUGAS")
  duplicateFileHandling   String @default("RENAME_INCREMENT")
}

model QuickShareRoom {
  id         String           @id @default(uuid())
  kode       String           @unique
  nama       String
  password   String?
  mode       String
  hostId     String?
  hostRole   String?
  batasWaktu DateTime
  batasSize  Int?
  batasFile  Int?
  status     String           @default("aktif")
  createdAt  DateTime         @default(now())
  files      QuickShareFile[]

  @@index([hostId])
}

model QuickShareFile {
  id           String         @id @default(uuid())
  roomId       String
  namaFile     String
  path         String
  ukuran       Int
  pengirim     String
  tipePengirim String         @default("GUEST")
  createdAt    DateTime       @default(now())
  room         QuickShareRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model XpSetting {
  id          String @id @default("1")
  xpBase      Float  @default(80)
  xpNilai70   Float  @default(20)
  xpNilai80   Float  @default(40)
  xpNilai90   Float  @default(70)
  xpNilai100  Float  @default(100)
  xpEarly     Float  @default(25)
  xpPerfect   Float  @default(70)
  xpBonusMax  Float  @default(20)
  xpPenaltiTidakKumpul Float @default(-50)
  titleConfig String @default("[]")
}

// Riwayat pengurangan XP: diterapkan pada siswa yang tidak mengerjakan/tidak
// mengumpulkan tugas setelah tugas ditutup guru.
// "Recently Deleted" / Sampah — snapshot hasil tugas siswa (file maupun mengetik)
// yang dihapus guru. Record asli tetap dihapus dari tabel Pengumpulan/
// PengumpulanMengetik (supaya siswa bisa mengumpulkan ulang), tapi seluruh
// datanya disalin ke sini dulu sehingga guru bisa melihat riwayat hapus dan
// memulihkannya (Restore) selama siswa belum mengumpulkan ulang.
model SampahPengumpulan {
  id          String   @id @default(uuid())
  jenis       String   // 'file' | 'mengetik'
  originalId  String   // id record asli sebelum dihapus
  tugasId     String
  siswaId     String
  tugasJudul  String
  siswaNama   String
  dataJson    String   // snapshot lengkap field record asli (JSON)
  deletedAt   DateTime @default(now())

  @@index([tugasId])
  @@index([siswaId])
  @@index([deletedAt])
}

model XpPenalti {
  id         String   @id @default(uuid())
  siswaId    String
  tugasId    String?
  xp         Float    @default(-50)
  keterangan String?
  createdAt  DateTime @default(now())
  siswa      Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tugas      Tugas?   @relation(fields: [tugasId], references: [id], onDelete: SetNull)

  @@unique([siswaId, tugasId])
  @@index([siswaId])
  @@index([tugasId])
}
